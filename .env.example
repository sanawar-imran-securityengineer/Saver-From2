# ============================================================================
#  SaverFrom configuration template
#
#  There are NO API keys in this project — every value below is optional.
#  With no .env file at all the application still starts and downloads work.
#
#  Copy to ".env" (repository root or backend/) and change what you need.
# ============================================================================

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=SaverFrom
APP_VERSION=3.0.0
DEBUG=false
ENVIRONMENT=production                 # development | production

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000                              # Hostinger: leave unset, the platform injects it
WORKERS=1
ROOT_PATH=                             # only if mounted on a sub-path, e.g. /api

# ── Storage ─────────────────────────────────────────────────────────────────
# Directory where finished downloads are written (auto-created).
# On Hostinger use an absolute path inside your home directory, e.g.
#   DOWNLOADS_DIR=/home/u123456789/domains/example.com/downloads
DOWNLOADS_DIR=./downloads

# ── Download limits ─────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=500
DOWNLOAD_TIMEOUT_SECONDS=300
FILE_TTL_MINUTES=30                    # downloads are deleted after this
MAX_CONCURRENT_DOWNLOADS=3
MAX_RETRIES=2
CLEANUP_INTERVAL_SECONDS=60

# ── Metadata cache ──────────────────────────────────────────────────────────
METADATA_CACHE_TTL=900

# ── Optional Redis L2 cache (leave empty on Hostinger) ──────────────────────
REDIS_URL=
CACHE_TTL=3600
CACHE_L1_MAXSIZE=2000
CACHE_L1_TTL=300

# ── CORS ────────────────────────────────────────────────────────────────────
# "*" works everywhere. For production replace with your real domains:
#   CORS_ORIGINS=https://saverfrom.com,https://www.saverfrom.com
CORS_ORIGINS=*
# Optional extra protection once the domain is live:
#   ALLOWED_HOSTS=saverfrom.com,www.saverfrom.com
ALLOWED_HOSTS=*

# ── Rate limiting & validation ──────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60               # 0 disables rate limiting
MAX_URL_LENGTH=2048
ALLOW_HTTP=false

# ── yt-dlp ──────────────────────────────────────────────────────────────────
YDL_TIMEOUT=30
YDL_RETRIES=3

# ── FFmpeg (only needed for MP3 audio and merged 1080p/4K video) ────────────
# If ffmpeg is not on PATH, point this at the folder containing ffmpeg/ffprobe.
#   FFMPEG_LOCATION=/home/u123456789/ffmpeg/bin
FFMPEG_LOCATION=